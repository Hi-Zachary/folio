{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "description": "Folio - a personal knowledge base with local RAG, OCR and streaming QA",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "start": "NODE_ENV=production node dist-server/src/index.js",
    "start:prod": "NODE_ENV=production node dist-server/src/migrate.js && NODE_ENV=production node dist-server/src/seed.js && NODE_ENV=production node dist-server/src/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "db:migrate": "tsx server/src/migrate.ts",
    "db:seed": "tsx server/src/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reindex": "tsx server/src/reindex.ts",
    "db:reembed": "tsx server/src/reembed.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "@langchain/openai": "1.6.0",
    "@langchain/qdrant": "1.0.3",
    "@langchain/textsplitters": "1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^1.44.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.2.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
