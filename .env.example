APP_PORT=3001
APP_ORIGIN=http://localhost:5173
# Leave empty in same-origin production Docker deployment; set a full URL for a separate API server.
VITE_API_URL=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=folio
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# Local file storage
UPLOAD_DIR=storage
MAX_UPLOAD_MB=50
PUBLIC_BASE_PATH=/folio
MAX_EMBEDDING_CANDIDATES=10000

# Multi-turn conversation memory.
# Older turns are folded into a rolling summary once the unsummarised history
# exceeds SUMMARY_TRIGGER_MESSAGES; the latest HISTORY_RECENT_MESSAGES stay verbatim.
HISTORY_RECENT_MESSAGES=8
HISTORY_MAX_CHARS=6000
SUMMARY_TRIGGER_MESSAGES=12
SUMMARY_MAX_CHARS=2000
# Rewrite the latest question into a standalone retrieval query using the history.
QUERY_REWRITE=true

# Agentic RAG: the model chooses tools (search chunks / list documents / read a
# document / list collections) before answering. Falls back to one-shot retrieval.
AGENT_ENABLED=true
AGENT_MAX_STEPS=4
AGENT_STEP_TIMEOUT_MS=20000

# Re-rank retrieved candidates before building the context.
# provider=api uses a dedicated cross-encoder endpoint (recommended, see local_models/);
# provider=llm falls back to listwise scoring with AI_UTILITY_MODEL; auto tries api then llm.
RERANK_ENABLED=true
RERANK_PROVIDER=api
RERANK_URL=http://127.0.0.1:8080/v1/rerank
RERANK_API_KEY=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=30
RERANK_MIN_SCORE=0.4
# Retrieval relevance gate: only chunks above these thresholds are injected into the model.
# SEARCH_SEMANTIC_MIN is cosine similarity (0-1) for embedding hits.
# Calibrate per embedding model: bge-m3 related ~0.58-0.66 / unrelated ~0.23-0.30 -> 0.45;
# qwen3-embedding related ~0.5 / unrelated ~0.1 -> 0.35.
SEARCH_SEMANTIC_MIN=0.45
SEARCH_FULLTEXT_MIN=0.5
SEARCH_KEYWORD_MIN=2
# Maximum number of chunks returned and injected into the model context.
SEARCH_RESULT_LIMIT=4
SEARCH_CANDIDATE_LIMIT=40
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=folio_chunks
AUTH_COOKIE_NAME=kb_session
AUTH_SESSION_DAYS=14
ALLOW_REGISTRATION=true
SECURE_COOKIES=false
DEFAULT_USER_EMAIL=local@folio.dev
DEFAULT_USER_NAME=本地系统用户

# Optional OpenAI-compatible model service.
# Examples: Ollama (http://localhost:11434/v1), SiliconFlow, or another compatible gateway.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek/deepseek-v4.1-flash
# Cheap/fast model for query rewrite, rerank and summary (defaults to AI_CHAT_MODEL).
AI_UTILITY_MODEL=deepseek/deepseek-v4.1-flash
# Embeddings can point at a different, e.g. local, OpenAI-compatible server.
# See local_models/serve.py; empty EMBEDDING_BASE_URL falls back to AI_BASE_URL.
AI_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_API_KEY=local
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
# Reasoning control for OpenRouter: off | low | medium | high (empty = don't send).
# Instruct models like qwen3-30b-a3b-instruct answer much faster with off.
AI_REASONING_EFFORT=off
# When retrieval finds nothing relevant, still answer with the model's general
# knowledge (clearly labelled as not from the user's materials) instead of refusing.
ANSWER_WITHOUT_CONTEXT=true

# OCR for scanned/image-only PDFs.
# Detection: if a PDF's extractable text is below OCR_MIN_CHARS_PER_PAGE per page,
# it is treated as scanned and OCR runs.
# provider=auto prefers local tesseract (apt install poppler-utils tesseract-ocr tesseract-ocr-chi-sim)
# and falls back to a vision model when OCR_MODEL is set (e.g. google/gemini-2.5-flash on OpenRouter).
OCR_ENABLED=true
OCR_PROVIDER=auto
OCR_MODEL=
OCR_LANGUAGE=chi_sim+eng
OCR_MIN_CHARS_PER_PAGE=30
OCR_MAX_PAGES=30
OCR_DPI=200

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=folio_chunks
